@model BusTicketBookingSystem.ViewModels.SeatSelectionViewModel
@{
    ViewData["Title"] = "Select Seats";

    // Build rows: 10 rows of 4 seats + 1 last row of 5 seats
    var seats = Model.Seats.OrderBy(s => s.SeatNumber).ToList();
    var rows = new List<List<BusTicketBookingSystem.Models.BusSeat>>();

    // Rows 1-10: seats 1..40 → 4 per row
    for (int i = 0; i < 40 && i < seats.Count; i += 4)
    {
        rows.Add(seats.Skip(i).Take(4).ToList());
    }
    // Last row: seats 41..45 → 5 per row
    if (seats.Count > 40)
    {
        rows.Add(seats.Skip(40).Take(5).ToList());
    }
}

<link rel="stylesheet" href="~/css/seat-map.css" />

<div class="container mt-4">

    @* ============ SCHEDULE INFO BAR ============ *@
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-3">
                    <small class="text-muted">Route</small>
                    <div class="fw-bold">@Model.Origin → @Model.Destination</div>
                </div>
                <div class="col-md-2">
                    <small class="text-muted">Bus</small>
                    <div class="fw-bold">@Model.BusNumber</div>
                </div>
                <div class="col-md-2">
                    <small class="text-muted">Date</small>
                    <div class="fw-bold">@Model.TravelDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-md-2">
                    <small class="text-muted">Departure</small>
                    <div class="fw-bold">@Model.DepartureTime</div>
                </div>
                <div class="col-md-3">
                    <small class="text-muted">Fare / seat</small>
                    <div class="fw-bold text-primary">Rs. @Model.Fare.ToString("N0")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @* ============ SEAT MAP ============ *@
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">🎫 Select Seats (max @Model.MaxSeatsPerBooking)</h5>
                        <small class="text-muted">
                            Bus capacity: <strong>@Model.TotalSeatsInBus</strong> seats
                        </small>
                    </div>

                    @* Legend *@
                    <div class="legend mb-4">
                        <span><span class="legend-box available"></span> Available</span>
                        <span><span class="legend-box selected"></span> Selected</span>
                        <span><span class="legend-box reserved"></span> Reserved</span>
                        <span><span class="legend-box booked"></span> Booked</span>
                        <span><span class="legend-box disabled"></span> Unavailable</span>
                    </div>

                    @* ============ REALISTIC BUS LAYOUT ============ *@
                    <div class="bus-container">

                        @* Driver area (top right) *@
                      @* Driver area — positioned above columns 3 & 4 (the right pair) *@
<div class="driver-area">
    <div class="driver-slot">
        <div class="driver-label">Driver</div>
        <div class="steering">
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <circle cx="50" cy="50" r="42" fill="none" stroke="#495057" stroke-width="5"/>
                <circle cx="50" cy="50" r="10" fill="#495057"/>
                <line x1="50" y1="40" x2="50" y2="10" stroke="#495057" stroke-width="5"/>
                <line x1="59" y1="55" x2="85" y2="68" stroke="#495057" stroke-width="5"/>
                <line x1="41" y1="55" x2="15" y2="68" stroke="#495057" stroke-width="5"/>
            </svg>
        </div>
    </div>
</div>  

                        @* ============ SEAT ROWS ============ *@
                        <div class="bus-rows">
                            @for (int r = 0; r < rows.Count; r++)
                            {
                                var row = rows[r];
                                var isLastRow = (r == rows.Count - 1) && row.Count == 5;

                                <div class="seat-row @(isLastRow ? "last-row" : "")">
                                    @for (int c = 0; c < row.Count; c++)
                                    {
                                        var seat = row[c];

                                        // For 4-seat rows, insert aisle spacer after 2nd seat
                                        if (!isLastRow && c == 2)
                                        {
                                            <div class="aisle-spacer"></div>
                                        }

                                        var cssClass = "seat";
                                        if (seat.Status == "Available") cssClass += " available";
                                        else if (seat.Status == "Reserved") cssClass += " reserved";
                                        else if (seat.Status == "Booked") cssClass += " booked";
                                        else cssClass += " disabled";

                                        var isDisabled = seat.Status != "Available";

                                        <div class="@cssClass"
                                             data-seat-number="@seat.SeatNumber"
                                             data-status="@seat.Status"
                                             data-disabled="@isDisabled.ToString().ToLower()">
                                            <span class="seat-number">@seat.SeatNumber</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                    </div>

                </div>
            </div>
        </div>

        @* ============ SELECTION SUMMARY ============ *@
        <div class="col-md-4">
            <div class="card shadow-sm sticky-summary">
                <div class="card-body">
                    <h5 class="mb-3">🧾 Your Selection</h5>

                    <div id="empty-state" class="text-muted text-center py-4">
                        No seats selected yet.
                    </div>

                    <div id="selection-list"></div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <span>Seats:</span>
                        <strong id="seat-count">0</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Total Fare:</span>
                        <strong class="text-primary">Rs. <span id="total-fare">0</span></strong>
                    </div>

                    <form asp-action="Reserve" method="post" id="reserveForm" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="scheduleId" value="@Model.ScheduleID" />
                        <input type="hidden" name="seatNumbers" id="seatNumbersInput" />

                        <button type="submit" class="btn btn-success w-100" id="reserveBtn" disabled>
                            ➡️ Continue to Payment
                        </button>
                    </form>

                    <a asp-action="Search" class="btn btn-outline-secondary w-100 mt-2">
                        ← Back to Search
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const MAX_SEATS = @Model.MaxSeatsPerBooking;
    const FARE = @Model.Fare;
    const selected = new Set();

    document.querySelectorAll('.seat.available').forEach(el => {
        el.addEventListener('click', () => toggleSeat(el));
    });

    function toggleSeat(el) {
        const seatNo = parseInt(el.dataset.seatNumber);
        if (selected.has(seatNo)) {
            selected.delete(seatNo);
            el.classList.remove('selected');
        } else {
            if (selected.size >= MAX_SEATS) {
                alert(`You can select a maximum of ${MAX_SEATS} seats.`);
                return;
            }
            selected.add(seatNo);
            el.classList.add('selected');
        }
        updateSummary();
    }

    function updateSummary() {
        const list = document.getElementById('selection-list');
        const empty = document.getElementById('empty-state');
        const count = document.getElementById('seat-count');
        const fare = document.getElementById('total-fare');
        const input = document.getElementById('seatNumbersInput');
        const btn = document.getElementById('reserveBtn');

        list.innerHTML = '';
        const arr = Array.from(selected).sort((a, b) => a - b);

        if (arr.length === 0) {
            empty.style.display = 'block';
            btn.disabled = true;
            input.value = '';
        } else {
            empty.style.display = 'none';
            btn.disabled = false;

            arr.forEach(n => {
                const tag = document.createElement('span');
                tag.className = 'badge bg-primary me-1 mb-1';
                tag.textContent = `Seat ${n}  ✕`;
                tag.style.cursor = 'pointer';
                tag.onclick = () => {
                    const el = document.querySelector(`.seat[data-seat-number="${n}"]`);
                    if (el) toggleSeat(el);
                };
                list.appendChild(tag);
            });

            input.value = arr.join(',');
        }

        count.textContent = arr.length;
        fare.textContent = (arr.length * FARE).toLocaleString();
    }
</script>
}