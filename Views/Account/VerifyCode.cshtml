@model BusTicketBookingSystem.ViewModels.VerifyResetCodeViewModel
@{
    ViewData["Title"] = "Verify Code";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="text-center mb-3">📩 Enter Verification Code</h2>

                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-info">@TempData["Message"]</div>
                    }

                    <p class="text-muted text-center mb-4">
                        Code sent to <strong>@Model.Email</strong>.
                        It expires in <strong>10 minutes</strong>.
                    </p>

                    <form asp-action="VerifyCode" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Email" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Code" class="form-label"></label>
                            <input asp-for="Code" class="form-control text-center"
                                   style="font-size:24px; letter-spacing:8px;"
                                   maxlength="6" inputmode="numeric"
                                   placeholder="000000" autofocus />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>

                        <hr />
                        <h6 class="mb-3">Set Your New Password</h6>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <input asp-for="NewPassword" class="form-control" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            ✅ Reset Password
                        </button>
                    </form>

                    <hr />
                    <p class="text-center mb-0">
                        Didn't receive the code?
                        <a asp-action="ForgotPassword">Try again</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}