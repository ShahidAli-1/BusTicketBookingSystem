@model BusTicketBookingSystem.Models.Booking
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Ticket - @Model.TicketNumber</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; max-width: 700px; margin: auto; }
        .ticket { border: 3px solid #333; padding: 20px; }
        h1 { text-align: center; margin-bottom: 5px; }
        .sub { text-align: center; color: #666; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; }
        td { padding: 8px; border-bottom: 1px solid #ddd; }
        td:first-child { font-weight: bold; width: 40%; }
        .footer { text-align: center; margin-top: 20px; font-size: 12px; color: #999; }
        @@media print {
            .no-print { display: none; }
        }
    </style>
</head>
<body>
    <div class="ticket">
        <h1>🚌 BUS TICKET</h1>
        <p class="sub">CONFIRMED</p>
        <table>
            <tr><td>Ticket Number</td><td>@Model.TicketNumber</td></tr>
            <tr><td>Booking Number</td><td>@Model.BookingNumber</td></tr>
            <tr><td>Passenger</td><td>@Model.Passenger?.FullName</td></tr>
            <tr><td>Email</td><td>@Model.Passenger?.Email</td></tr>
            <tr><td>Route</td><td>@Model.Schedule?.Bus?.Route?.Origin → @Model.Schedule?.Bus?.Route?.Destination</td></tr>
            <tr><td>Bus</td><td>@Model.Schedule?.Bus?.BusNumber - @Model.Schedule?.Bus?.BusName</td></tr>
            <tr><td>Travel Date</td><td>@Model.Schedule?.TravelDate.ToString("dd MMMM yyyy")</td></tr>
            <tr><td>Departure</td><td>@Model.Schedule?.DepartureTime</td></tr>
           <tr>
    <td>Seat@(Model.SeatCount > 1 ? "s" : "")</td>
    <td><strong>@Model.SeatNumbersDisplay</strong></td>
</tr>
            <tr><td>Fare</td><td>Rs. @Model.Fare.ToString("N0")</td></tr>
            <tr><td>Confirmed At</td><td>@Model.ConfirmedAt?.ToString("dd MMM yyyy HH:mm")</td></tr>
        </table>
        <div class="footer">
            <p>Generated on @DateTime.Now.ToString("dd MMM yyyy HH:mm")</p>
            <p>Please arrive 30 minutes before departure.</p>
        </div>
    </div>

    <<div class="no-print" style="text-align:center; margin-top:20px;">
    <button onclick="window.print()" class="btn btn-primary">🖨️ Download</button>
    <a href="/Passenger/BookingHistory" class="btn btn-secondary"> Back</a>
</div>

<script>
    // If URL contains ?auto=1, auto-open the print dialog
    if (window.location.search.includes('auto=1')) {
        window.addEventListener('load', function() {
            setTimeout(() => window.print(), 300);
        });
    }
</script>
</body>
</html>