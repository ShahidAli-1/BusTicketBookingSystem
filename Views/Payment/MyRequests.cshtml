@model List<BusTicketBookingSystem.Models.PaymentRequest>
@{ ViewData["Title"] = "My Payment Requests"; }

<h1>💳 My Payment Requests</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">No payment requests.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr><th>Booking #</th><th>Route</th><th>Amount</th><th>Method</th><th>Submitted</th><th>Status</th><th>Remarks</th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Booking?.BookingNumber</td>
                    <td>@p.Booking?.Schedule?.Bus?.Route?.RouteName</td>
                    <td>Rs. @p.Amount.ToString("N0")</td>
                    <td>@p.PaymentMethod</td>
                    <td>@p.SubmittedAt.ToString("dd MMM yyyy HH:mm")</td>
                    <td>
                        <span class="badge bg-@(p.Status switch {
                            "Approved" => "success",
                            "Rejected" => "danger",
                            _ => "warning"
                        })">@p.Status</span>
                    </td>
                    <td>@p.AdminRemarks</td>
                </tr>
            }
        </tbody>
    </table>
}