@model BusTicketBookingSystem.ViewModels.RescheduleViewModel
@{
    ViewData["Title"] = "Reschedule Trip";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-9">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">🔄 Reschedule Trip</h4>
                </div>

                <div class="card-body">

                    @* ============ SOURCE INFO ============ *@
                    <div class="alert alert-info">
                        <h6 class="mb-2">📋 Original Schedule (for reference)</h6>
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <td class="text-muted" style="width: 30%;">Bus</td>
                                <td><strong>@Model.OldBusNumber</strong> — @Model.OldBusName</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Route</td>
                                <td><strong>@Model.OldRouteName</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Date</td>
                                <td>@Model.OldTravelDate.ToString("dd MMM yyyy")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Time</td>
                                <td>@Model.OldDepartureTime → @Model.OldArrivalTime</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Fare</td>
                                <td>Rs. @Model.OldFare.ToString("N0")</td>
                            </tr>
                        </table>
                    </div>

                    <hr />

                    @* ============ NEW SCHEDULE FORM ============ *@
                    <h5 class="mb-3">🆕 New Schedule Details</h5>

                    <form asp-action="Reschedule" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="SourceScheduleID" />
                        <input type="hidden" asp-for="OldBusNumber" />
                        <input type="hidden" asp-for="OldBusName" />
                        <input type="hidden" asp-for="OldRouteName" />
                        <input type="hidden" asp-for="OldTravelDate" />
                        <input type="hidden" asp-for="OldDepartureTime" />
                        <input type="hidden" asp-for="OldArrivalTime" />
                        <input type="hidden" asp-for="OldFare" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        @* ---- Bus ---- *@
                        <div class="mb-3">
                            <label asp-for="NewBusID" class="form-label"></label>
                            <select asp-for="NewBusID"
                                    asp-items="Model.BusOptions"
                                    class="form-select">
                                <option value="">-- Select Bus --</option>
                            </select>
                            <span asp-validation-for="NewBusID" class="text-danger"></span>
                            <small class="text-muted">
                                Changing the bus will also change the seat layout and capacity.
                            </small>
                        </div>

                        <div class="row">
                            @* ---- Date ---- *@
                            <div class="col-md-6 mb-3">
                                <label asp-for="NewTravelDate" class="form-label"></label>
                                <input asp-for="NewTravelDate" type="date" class="form-control"
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="NewTravelDate" class="text-danger"></span>
                            </div>

                            @* ---- Fare ---- *@
                            <div class="col-md-6 mb-3">
                                <label asp-for="NewFare" class="form-label"></label>
                                <input asp-for="NewFare" type="number" step="0.01"
                                       class="form-control" min="1" />
                                <span asp-validation-for="NewFare" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            @* ---- Departure ---- *@
                            <div class="col-md-6 mb-3">
                                <label asp-for="NewDepartureTime" class="form-label"></label>
                                <input asp-for="NewDepartureTime" type="time" class="form-control" />
                                <span asp-validation-for="NewDepartureTime" class="text-danger"></span>
                            </div>

                            @* ---- Arrival ---- *@
                            <div class="col-md-6 mb-3">
                                <label asp-for="NewArrivalTime" class="form-label"></label>
                                <input asp-for="NewArrivalTime" type="time" class="form-control" />
                                <span asp-validation-for="NewArrivalTime" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="alert alert-warning small">
                            ⚠️ This creates a <strong>new schedule</strong>.
                            The original stays in history. Fresh seats are initialized
                            for the selected bus.
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                🔄 Create Rescheduled Trip
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}