@model BusTicketBookingSystem.Models.Route
@{ ViewData["Title"] = "Create Route"; }

<h1>🗺️ Create Route</h1>

<form asp-action="Create" method="post" style="max-width: 600px;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="RouteName" class="form-label"></label>
        <input asp-for="RouteName" class="form-control" placeholder="e.g. Multan-Lahore" />
        <span asp-validation-for="RouteName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Origin" class="form-label"></label>
        <input asp-for="Origin" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Destination" class="form-label"></label>
        <input asp-for="Destination" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" type="number" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="EstimatedDuration" class="form-label"></label>
        <input asp-for="EstimatedDuration" class="form-control" placeholder="e.g. 5 hours" />
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}