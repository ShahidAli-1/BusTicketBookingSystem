@model List<BusTicketBookingSystem.Models.Bus>
@{ ViewData["Title"] = "Buses"; }

<div class="d-flex justify-content-between align-items-center">
    <h1>🚌 Buses</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add Bus</a>
</div>

@* ============ SEARCH BAR ============ *@
<form method="get" class="card card-body shadow-sm mb-3 mt-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small">Search</label>
            <input name="search" class="form-control"
                   placeholder="Bus number or name..."
                   value="@ViewBag.Search" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">Type</label>
            <select name="type" class="form-select">
                <option value="">All</option>
                <option value="Standard" selected="@(ViewBag.Type == "Standard")">Standard</option>
                <option value="Executive" selected="@(ViewBag.Type == "Executive")">Executive</option>
                <option value="Business" selected="@(ViewBag.Type == "Business")">Business</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small">Route</label>
            <select name="routeId" asp-items="ViewBag.Routes" class="form-select">
                <option value="">All Routes</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">Status</label>
            <select name="status" class="form-select">
                <option value="">All</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100">🔍</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string) ||
         !string.IsNullOrWhiteSpace(ViewBag.Type as string) ||
         !string.IsNullOrWhiteSpace(ViewBag.Status as string) ||
         (ViewBag.RouteId != null))
    {
        <div class="mt-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                ✕ Clear filters
            </a>
        </div>
    }
</form>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Bus #</th><th>Name</th><th>Type</th><th>Seats</th><th>Route</th><th>Status</th><th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.BusNumber</td>
                <td>@b.BusName</td>
                <td>@b.BusType</td>
                <td>@b.TotalSeats</td>
                <td>@b.Route?.RouteName</td>
                <td>
                    <span class="badge bg-@(b.IsActive ? "success" : "danger")">
                        @(b.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@b.BusID" class="btn btn-sm btn-outline-info">View</a>
                    <a asp-action="Edit" asp-route-id="@b.BusID" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="ToggleActive" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@b.BusID" />
                        <button class="btn btn-sm btn-outline-@(b.IsActive ? "warning" : "success")">
                            @(b.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>